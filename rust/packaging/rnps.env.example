# rnps 运行环境变量（systemd EnvironmentFile）
#
# 复制为 /etc/nps/nps.env 并填写；权限必须是 0600，属主 root:root。
#    install -m 0600 -o root -g root rnps.env.example /etc/nps/nps.env
#
# ---------------------------------------------------------------------------
# NPS_ADMIN_TOKEN —— 管理 API 的 Bearer 令牌，必填
# ---------------------------------------------------------------------------
# 要求：至少 24 字节的随机值（程序启动时校验，短于 24 字节会直接退出）。
# 生成方法（任选其一）：
#     openssl rand -base64 32
#     head -c 32 /dev/urandom | base64 | tr -d '\n'
#
# 绝对不要使用默认值、示例值或任何可猜测的字符串。这个值的强度
# 就是管理端的全部防护（管理端是明文 HTTP，见 README 的 HTTPS 反代说明）。
# 生成后请同时存进密码管理器；泄漏后所有隧道启停权限都会失控。
NPS_ADMIN_TOKEN=

# ---------------------------------------------------------------------------
# RUST_LOG —— 日志级别，可选
# ---------------------------------------------------------------------------
# 默认 info。排查连接问题时可用 nps_server=debug,nps_legacy=debug。
# 日志里不会打印 vkey、md5(vkey) 或管理令牌。
RUST_LOG=info